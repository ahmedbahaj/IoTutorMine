# Vercel serverless environment variables for the IoTutorMine API.
#
# Names only - never commit real values. Set these in the Vercel project under
# Settings -> Environment Variables. None of them are ever exposed to the
# frontend: the GitHub Pages bundle only calls the Vercel API.

# --- Required: component extraction (already configured today) ---
GEMINI_KEY=

# --- Optional: transcript fallback (already configured today) ---
SUPADATA_KEY=

# --- Required for the shared extraction library ---
# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The SERVICE ROLE key, not the anon key. It bypasses RLS and must never be
# placed in frontend code or in a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional hardening ---
# When set, an explicit "Re-extract" must send a matching X-Refresh-Token
# header. Leave unset to allow re-extraction under the standard rate limit.
REFRESH_TOKEN=

# --- Optional: serverless timeout budget (milliseconds) ---
# A serverless function has a hard wall-clock limit. These defaults keep the
# worst-case path under ~60s. Raise or lower them to match your Vercel plan.
#   claim 5s + transcript 10s + Supadata 10s + Gemini 30s + persist 5s
GEMINI_TIMEOUT_MS=
TRANSCRIPT_TIMEOUT_MS=
STORE_TIMEOUT_MS=

# How long a request waits for another serverless instance that is already
# extracting the same video. Defaults: 8000 / 1000.
PEER_WAIT_MS=
PEER_POLL_MS=

# How long an extraction lease is held before it is considered abandoned
# (seconds). Default: 180.
LEASE_SECONDS=
